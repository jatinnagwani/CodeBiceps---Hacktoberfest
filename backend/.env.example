# ==============================================================================
# PRoof Backend Environment Configuration (Example)
#
# PRoof is 100% local-first and privacy-preserving.
# NO third-party AI API keys (OpenAI, Anthropic, Gemini, etc.) are needed or accepted.
# Copy this file to .env to customize local development settings.
# ==============================================================================

# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Local Ollama AI Model Settings
# Default model name is 'proof-reviewer'
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=proof-reviewer
OLLAMA_TIMEOUT_MS=20000
OLLAMA_TEMPERATURE=0.1

# Optional GitHub Token for Claim Watch (live GitHub API rate limit: 5000/hr vs 60/hr unauthenticated)
# Public API and Demo Mode work out of the box without any token.
# GITHUB_TOKEN=ghp_your_personal_access_token_here
